# Kenichi Flash — Full Precision (Mac Studio 256GB, multi-GPU servers)
# Devstral Small 2 (24B) | F16 model | FP16 KV cache | ~256K context (model max)
#
# True zero quantization. F16 model weights + unquantized FP16 KV cache.
# No compromises anywhere in the inference pipeline.
#
# Memory: ~48 GB model + ~42 GB FP16 KV at 256K = ~90 GB total
# Fits comfortably in 128+ GB unified memory (Mac Studio M4 Ultra)
#
# Setup:
#   1. Download GGUF:
#      hf download odytrice/kenichi-flash-GGUF F16.gguf --local-dir ./kenichi-flash
#
#   2. No KV cache quantization needed! Use default FP16:
#      export OLLAMA_KV_CACHE_TYPE=f16
#      (or simply don't set OLLAMA_KV_CACHE_TYPE — f16 is the default)
#
#   3. Create and run:
#      ollama create kenichi-flash:full -f Modelfile.kenichi-flash-full
#      ollama run kenichi-flash:full

FROM /workspace/kenichi-flash-F16.gguf

# Template matches Unsloth's "mistral" chat_template used during training.
# System prompt is concatenated with the first user message inside [INST] tags.
# This is the Mistral v0.1/v0.2 format, NOT the v3 [SYSTEM_PROMPT] format.
TEMPLATE """[INST] {{ if .System }}{{ .System }} {{ end }}{{ .Prompt }} [/INST]"""

SYSTEM """You are Kenichi, a coding assistant."""

PARAMETER stop "[INST]"
PARAMETER stop "[/INST]"
PARAMETER temperature 0.6
PARAMETER top_p 0.95
PARAMETER top_k 40
PARAMETER num_ctx 262144
