# Kenichi Flash — 96 GB VRAM Profile (RTX PRO 6000, A100 80GB, H100)
# Devstral Small 2 (24B) | Q8_0 model | FP16 KV cache | ~256K context (model max)
#
# Near-lossless model with unquantized FP16 KV cache at full context.
# Model: ~26 GB | FP16 KV at 256K: ~42 GB | Total: ~68 GB → plenty of headroom.
#
# Setup:
#   1. Download GGUF:
#      hf download odytrice/kenichi-flash Q8_0.gguf --local-dir ./kenichi-flash
#
#   2. No KV cache quantization needed! Use default FP16:
#      export OLLAMA_KV_CACHE_TYPE=f16
#      (or simply don't set OLLAMA_KV_CACHE_TYPE — f16 is the default)
#
#   3. Create and run:
#      ollama create kenichi-flash:96gb -f Modelfile.kenichi-flash-96gb
#      ollama run kenichi-flash:96gb

FROM /workspace/Q8_0.gguf

# Chat template is auto-detected from GGUF metadata (Mistral v7 Tekken format).
# Do NOT override with a custom TEMPLATE — the model was trained with the tokenizer's
# native chat template applied by Unsloth, and mismatches cause garbled output.

SYSTEM """You are Kenichi, an expert coding assistant specialized in F#, .NET, Svelte 5, SvelteKit, TypeScript, Docker, and Kubernetes. You write clean, idiomatic, and well-structured code with clear explanations."""

PARAMETER temperature 0.6
PARAMETER top_p 0.95
PARAMETER top_k 40
PARAMETER num_ctx 262144
