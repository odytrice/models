# Kenichi Flash — 24 GB VRAM Profile (RTX 4090, RTX 3090)
# Devstral Small 2 (24B) | Q4_K_M model | Q8 KV cache | ~121K context
#
# Setup:
#   1. Download GGUF:
#      hf download odytrice/kenichi-flash Q4_K_M.gguf --local-dir ./kenichi-flash
#
#   2. Set KV cache quantization (required — add to your shell profile):
#      export OLLAMA_KV_CACHE_TYPE=q8_0
#
#   3. Create and run:
#      ollama create kenichi-flash:24gb -f Modelfile.kenichi-flash-24gb
#      ollama run kenichi-flash:24gb

FROM /workspace/Q4_K_M.gguf

# Template matches Unsloth's "mistral" chat_template used during training.
# System prompt is prepended to the first user message inside [INST] tags.
# Multi-turn format based on Unsloth's mistral_v03_ollama.
TEMPLATE """{{- if .Messages }}{{- range $index, $_ := .Messages }}{{- if eq .Role "user" }}[INST] {{ if and $.System (eq (len (slice $.Messages $index)) 1) }}{{ $.System }} {{ end }}{{ .Content }} [/INST]{{- else if eq .Role "assistant" }}{{ .Content }}</s>{{- end }}{{- end }}{{- else }}[INST] {{ if .System }}{{ .System }} {{ end }}{{ .Prompt }} [/INST]{{- end }}{{ .Response }}{{- if .Response }}</s>{{- end }}"""

SYSTEM """You are Kenichi, an expert coding assistant specialized in F#, .NET, Svelte 5, SvelteKit, TypeScript, Docker, and Kubernetes. You write clean, idiomatic, and well-structured code with clear explanations."""

PARAMETER stop "[INST]"
PARAMETER stop "[/INST]"
PARAMETER stop "</s>"
PARAMETER temperature 0.6
PARAMETER top_p 0.95
PARAMETER top_k 40
PARAMETER num_ctx 121000
