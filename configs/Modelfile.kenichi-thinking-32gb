# Kenichi Thinking — 32 GB VRAM Profile (RTX 5090)
# Qwen3.5-27B | Q4_K_M model | Q4 KV cache | ~177K context
#
# Setup:
#   1. Download GGUF:
#      hf download odytrice/kenichi-thinking Q4_K_M.gguf --local-dir ./kenichi-thinking
#
#   2. Set KV cache quantization (required — add to your shell profile):
#      export OLLAMA_KV_CACHE_TYPE=q4_0
#
#   3. Create and run:
#      ollama create kenichi-thinking:32gb -f Modelfile.kenichi-thinking-32gb
#      ollama run kenichi-thinking:32gb

FROM /workspace/Q4_K_M.gguf

# Chat template is auto-detected from GGUF metadata (ChatML / Qwen format).
# Do NOT override with a custom TEMPLATE — the model was trained with the tokenizer's
# native chat template, and mismatches cause garbled output.

SYSTEM """You are Kenichi, an expert coding assistant specialized in F#, .NET, Svelte 5, SvelteKit, TypeScript, Docker, and Kubernetes. You write clean, idiomatic, and well-structured code with clear explanations."""

PARAMETER temperature 0.6
PARAMETER top_p 0.95
PARAMETER top_k 40
PARAMETER num_ctx 177000
