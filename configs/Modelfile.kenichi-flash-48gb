# Kenichi Flash — 48 GB VRAM Profile (RTX A6000 Ada, 2x 24GB)
# Devstral Small 2 (24B) | Q8_0 model | Q8 KV cache | ~256K context (model max)
#
# Near-lossless quality at full context. The best possible local experience.
#
# Setup:
#   1. Download GGUF:
#      hf download odytrice/kenichi-flash Q8_0.gguf --local-dir ./kenichi-flash
#
#   2. Set KV cache quantization (required — add to your shell profile):
#      export OLLAMA_KV_CACHE_TYPE=q8_0
#
#   3. Create and run:
#      ollama create kenichi-flash:48gb -f Modelfile.kenichi-flash-48gb
#      ollama run kenichi-flash:48gb

FROM /workspace/Q8_0.gguf

# Template matches Unsloth's "mistral" chat_template used during training.
# System prompt is concatenated with the first user message inside [INST] tags.
# This is the Mistral v0.1/v0.2 format, NOT the v3 [SYSTEM_PROMPT] format.
TEMPLATE """[INST] {{ if .System }}{{ .System }} {{ end }}{{ .Prompt }} [/INST]"""

SYSTEM """You are Kenichi, a coding assistant."""

PARAMETER stop "[INST]"
PARAMETER stop "[/INST]"
PARAMETER temperature 0.6
PARAMETER top_p 0.95
PARAMETER top_k 40
PARAMETER num_ctx 262144
