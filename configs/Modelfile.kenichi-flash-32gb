# Kenichi Flash — 32 GB VRAM Profile (RTX 5090)
# Devstral Small 2 (24B) | Q5_K_M model | Q8 KV cache | ~182K context
#
# Setup:
#   1. Download GGUF:
#      hf download odytrice/kenichi-flash Q5_K_M.gguf --local-dir ./kenichi-flash
#
#   2. Set KV cache quantization (required — add to your shell profile):
#      export OLLAMA_KV_CACHE_TYPE=q8_0
#
#   3. Create and run:
#      ollama create kenichi-flash:32gb -f Modelfile.kenichi-flash-32gb
#      ollama run kenichi-flash:32gb

FROM /workspace/Q5_K_M.gguf

# Chat template is auto-detected from GGUF metadata (Mistral v7 Tekken format).
# Do NOT override with a custom TEMPLATE — the model was trained with the tokenizer's
# native chat template applied by Unsloth, and mismatches cause garbled output.

SYSTEM """You are Kenichi, an expert coding assistant specialized in F#, .NET, Svelte 5, SvelteKit, TypeScript, Docker, and Kubernetes. You write clean, idiomatic, and well-structured code with clear explanations."""

PARAMETER temperature 0.6
PARAMETER top_p 0.95
PARAMETER top_k 40
PARAMETER num_ctx 182000
