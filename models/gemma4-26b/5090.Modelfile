# Gemma 4 26B - RTX 5090 (32 GB VRAM)
# Known-good Ollama source. The direct HF UD-Q6_K import currently
# fails to load on the remote Ollama 0.23.x server.
#
# Create:
#   ollama create odytrice/gemma4-26b:5090 -f 5090.Modelfile
#
# Run:
#   ollama run odytrice/gemma4-26b:5090
#
# Push:
#   ollama push odytrice/gemma4-26b:5090

FROM gemma4:26b

PARAMETER num_ctx 131072
PARAMETER num_gpu 999
