# Gemma 4 31B — RTX 4090 (24 GB VRAM, Q4_K_M)
# NVFP4 not used: Ada Lovelace tensor cores do not support FP4.
# Note: 31B dense at Q4_K_M is tight on 24 GB. Verify with `ollama ps` — if any CPU%, lower num_ctx.
#
# Create:
#   ollama create odytrice/gemma4-31b:4090 -f Modelfile.gemma4-31b
#
# Run:
#   ollama run odytrice/gemma4-31b:4090
#
# Push:
#   ollama push odytrice/gemma4-31b:4090

FROM gemma4:31b

PARAMETER num_ctx 65536
