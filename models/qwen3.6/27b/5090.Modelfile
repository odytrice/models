# Qwen 3.6 27B - RTX 5090 (32 GB VRAM)
# Known-good Ollama source. The direct HF NVFP4-GGUF import currently
# produces a malformed template artifact on the remote Ollama 0.23.x server.
#
# Create:
#   ollama create odytrice/qwen3.6:5090-27b -f 5090.Modelfile
#
# Run:
#   ollama run odytrice/qwen3.6:5090-27b
#
# Push:
#   ollama push odytrice/qwen3.6:5090-27b

FROM qwen3.6:27b

PARAMETER num_ctx 262144
PARAMETER num_gpu 999
