# Gemma 4 12B - RTX 4090 (24 GB VRAM, Q8_0)
# Uses the local 12B instruction Q8_0 Ollama source for the Ada profile.
#
# Create:
#   ollama create odytrice/gemma4-12b:4090 -f 4090.Modelfile
#
# Run:
#   ollama run odytrice/gemma4-12b:4090
#
# Push:
#   ollama push odytrice/gemma4-12b:4090

FROM gemma4:12b-it-q8_0

PARAMETER num_ctx 262144
PARAMETER num_gpu 999
