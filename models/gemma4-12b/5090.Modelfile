# Gemma 4 12B - RTX 5090 (32 GB VRAM, BF16)
# Uses the local 12B instruction BF16 Ollama source for the Blackwell profile.
#
# Create:
#   ollama create odytrice/gemma4-12b:5090 -f 5090.Modelfile
#
# Run:
#   ollama run odytrice/gemma4-12b:5090
#
# Push:
#   ollama push odytrice/gemma4-12b:5090

FROM gemma4:12b-it-bf16

PARAMETER num_ctx 262144
PARAMETER num_gpu 999
