# Qwen 3.6 35B - RTX 5090 (32 GB VRAM)
# Known-good Ollama source. The direct HF UD-Q5_K_M import currently
# produces a malformed template/projector artifact on Ollama 0.23.x.
#
# Create:
#   ollama create odytrice/qwen3.6-35b:5090 -f 5090.Modelfile
#
# Run:
#   ollama run odytrice/qwen3.6-35b:5090
#
# Push:
#   ollama push odytrice/qwen3.6-35b:5090

FROM qwen3.6:35b

PARAMETER num_ctx 131072
PARAMETER num_gpu 999
