# Gemma 4 26B - RTX 4090 (24 GB VRAM, Q4_K_M)
# NVFP4 not used: Ada Lovelace tensor cores do not support FP4. Q4_K_M GGUF is the standard Ada path.
#
# Create:
#   ollama create odytrice/gemma4:4090-26b -f 4090.Modelfile
#
# Run:
#   ollama run odytrice/gemma4:4090-26b
#
# Push:
#   ollama push odytrice/gemma4:4090-26b

FROM gemma4:26b

PARAMETER num_ctx 131072
PARAMETER num_gpu 999
