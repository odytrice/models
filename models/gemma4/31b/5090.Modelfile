# Gemma 4 31B - RTX 5090 (32 GB VRAM)
# Known-good Ollama source. The direct HF NVFP4-GGUF import currently
# fails to load on the remote Ollama 0.23.x server.
#
# Create:
#   ollama create odytrice/gemma4:5090-31b -f 5090.Modelfile
#
# Run:
#   ollama run odytrice/gemma4:5090-31b
#
# Push:
#   ollama push odytrice/gemma4:5090-31b

FROM gemma4:31b

PARAMETER num_ctx 153600
PARAMETER num_gpu 999
